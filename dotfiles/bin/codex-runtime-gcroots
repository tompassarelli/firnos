#!/usr/bin/env bash
# Keep the Nix store dependencies of every installed Codex runtime alive.
#
# Codex runtimes are deliberately out-of-store (see the closure policy), but a
# locally built runtime still resolves its ELF interpreter and RUNPATH out of
# /nix/store. Nothing else roots those paths, so `nix-collect-garbage` silently
# removes them and the runtime then fails with a misleading
# "cannot execute: required file not found".
#
# Each runtime carries its own indirect roots, so removing a runtime directory
# releases them.
set -uo pipefail

versions="${CODEX_RUNTIME_VERSIONS:-$HOME/.local/lib/codex/versions}"
[ -d "$versions" ] || {
  printf 'codex-runtime-gcroots: no runtimes at %s\n' "$versions" >&2
  exit 0
}

command -v patchelf >/dev/null 2>&1 || {
  echo 'codex-runtime-gcroots: patchelf is required' >&2
  exit 127
}
command -v nix-store >/dev/null 2>&1 || {
  echo 'codex-runtime-gcroots: nix-store is required' >&2
  exit 127
}

# Interpreter plus every RUNPATH/RPATH entry, reduced to its store root.
store_deps() {
  {
    patchelf --print-interpreter "$1" 2>/dev/null
    patchelf --print-rpath "$1" 2>/dev/null | tr ':' '\n'
  } | grep '^/nix/store/' | sed -E 's|^(/nix/store/[^/]+).*|\1|' | sort -u
}

# Only the selected runtime gates success. A retired runtime whose deps are
# already collected is expected, not a failure worth failing a login on.
current="$(realpath -e "${versions%/versions}/current/bin/codex" 2>/dev/null || true)"

rooted=0
absent=0
absent_current=0
for binary in "$versions"/*/bin/codex; do
  [ -f "$binary" ] || continue
  roots="$(dirname "$(dirname "$binary")")/.nix-gcroots"
  selected=0
  [ -n "$current" ] && [ "$(realpath -e "$binary")" = "$current" ] && selected=1

  while IFS= read -r dep; do
    [ -n "$dep" ] || continue
    if [ ! -e "$dep" ]; then
      # Already collected. Substituting here would silently pull the network on
      # a login path; report instead and let the operator decide.
      printf 'codex-runtime-gcroots: missing %s (needed by %s)\n' \
        "$dep" "$binary" >&2
      absent=$((absent + 1))
      [ "$selected" -eq 1 ] && absent_current=$((absent_current + 1))
      continue
    fi
    mkdir -p "$roots"
    if nix-store --add-root "$roots/${dep##*/}" --indirect --realise "$dep" \
         >/dev/null 2>&1; then
      rooted=$((rooted + 1))
    else
      printf 'codex-runtime-gcroots: could not root %s\n' "$dep" >&2
      absent=$((absent + 1))
      [ "$selected" -eq 1 ] && absent_current=$((absent_current + 1))
    fi
  done <<<"$(store_deps "$binary")"
done

printf 'codex-runtime-gcroots: %d rooted, %d unresolved\n' "$rooted" "$absent"
[ "$absent_current" -eq 0 ]
