Snapshot:
  repository: Text
  revision: Text
  branch: Text
  host: Text
  platform: Text

WarmSpec:
  uri: Text
  attribute: Text
  key: Text

LeaseOwner:
  worker-pid: F64
  child-pid: F64
  key: Text

Invalid:
  message: Text

ProcessIdentity:
  pid: F64
  argv: Sequence<Text>

Deduplicated:
  deduplicated: Text

Contended:
  contended: Text

Supersede:
  child-pid: F64
  worker-pid: F64

StampWrite:
  text: Text

StampUnchanged:
  status: F64

HookLaunch:
  argv: Sequence<Text>

HookIgnored:
  state: Text

Take:
  index: F64
  values: Sequence<Text>

take-result(?values: Sequence<Text>, ?count: F64): Take
  fold(?values, {index: 0, values: []}, ?result, ?value,
    {index: ?result.index + 1,
     values: if(?result.index < ?count, append(?result.values, ?value), ?result.values)})

take(?values: Sequence<Text>, ?count: F64): Sequence<Text>
  take-result(?values, ?count).values

first(?values: Sequence<Text>): Text
  join(take(?values, 1), "")

last(?values: Sequence<Text>): Text
  fold(?values, "", ?previous, ?value, ?value)

split-fields(?parts: Sequence<Text>): Sequence<Text>
  if(last(?parts) = "", take(?parts, count(?parts) - 1), ?parts)

split-delimited(?text: Text, ?delimiter: Text): Sequence<Text>
  if(?text = "", [], split-fields(split-text(?text, ?delimiter)))

append-unique(?values: Sequence<Text>, ?candidate: Text): Sequence<Text>
  if(fold(?values, false, ?found, ?value, ?found or ?value = ?candidate),
    ?values, append(?values, ?candidate))

layout-main(?checkout: Text): Sequence<Text>
  if(contains-text(?checkout, "/worktrees/"),
    [first(split-text(?checkout, "/worktrees/")) ++ "/main"],
    if(contains-text(?checkout, "/pins/"),
      [first(split-text(?checkout, "/pins/")) ++ "/main"], []))

common-main-parts(?parts: Sequence<Text>): Sequence<Text>
  if(count(?parts) > 1 and last(?parts) = "",
    [join(take(?parts, count(?parts) - 1), "/.git")], [])

common-main(?directory: Text): Sequence<Text>
  common-main-parts(split-text(?directory, "/.git"))

export container-main-candidates(?checkout: Text, ?common-directory: Text | Invalid): Sequence<Text>
  append-unique(match(?common-directory,
    ?directory: Text => fold(common-main(?directory), layout-main(?checkout), ?paths, ?path, append-unique(?paths, ?path)),
    ?unavailable: Invalid => layout-main(?checkout)), ?checkout)

export short-host(?host: Text): Text
  first(split-text(?host, "."))

snapshot-uri(?snapshot: Snapshot): Text
  "git+file://{?snapshot.repository}?rev={?snapshot.revision}{if(?snapshot.branch = "", "", "&ref={?snapshot.branch}")}"

target-attribute(?snapshot: Snapshot): Text
  if(?snapshot.platform = "darwin",
    "darwinConfigurations.{?snapshot.host}.system",
    "nixosConfigurations.{?snapshot.host}.config.system.build.toplevel")

spec(?uri: Text, ?attribute: Text): WarmSpec
  {uri: ?uri, attribute: ?attribute, key: "{?uri}#{?attribute}"}

export warm-spec(?snapshot: Snapshot): WarmSpec
  spec(snapshot-uri(?snapshot), target-attribute(?snapshot))

positive-integer(?text: Text): F64 | Invalid
  match(parse-integer-prefix(?text),
    ?number: F64 => if(?number > 0, ?number, {message: "expected positive pid"}),
    ?invalid: Text => {message: "expected positive pid"})

owner-pids(?worker: F64 | Invalid, ?child: F64 | Invalid, ?key: Text): LeaseOwner | Invalid
  match(?worker,
    ?invalid: Invalid => {message: "invalid worker pid, child pid, or key"},
    ?worker-pid: F64 => match(?child,
      ?invalid: Invalid => {message: "invalid worker pid, child pid, or key"},
      ?child-pid: F64 => if(?key != "", {worker-pid: ?worker-pid, child-pid: ?child-pid, key: ?key},
        {message: "invalid worker pid, child pid, or key"})))

owner-fields(?fields: Sequence<Text>): LeaseOwner | Invalid
  if(count(?fields) = 3,
    owner-pids(positive-integer(first(?fields)), positive-integer(first(drop(?fields, 1))), last(?fields)),
    {message: "expected worker pid, child pid, and key"})

export parse-lease-owner(?text: Text): LeaseOwner | Invalid
  owner-fields(split-delimited(?text, "\n"))

export render-owner(?owner: LeaseOwner): Text
  "{?owner.worker-pid}\n{?owner.child-pid}\n{?owner.key}\n"

export command-argv(?cmdline: Text): Sequence<Text>
  if(?cmdline = "", [], split-delimited(?cmdline, last(characters(?cmdline))))

export worker-argv(?executable: Text, ?repository: Text, ?key: Text): Sequence<Text>
  [?executable, "--worker", ?executable, ?repository, ?key]

export nix-build-argv(?key: Text): Sequence<Text>
  ["nix", "build", "--no-link", "--print-out-paths", ?key]

export detached-worker-argv(?executable: Text, ?repository: Text, ?key: Text): Sequence<Text>
  ["setsid", "-f", "nice", "-n", "19", "ionice", "-c", "3", ?executable, "--worker", ?executable, ?repository, ?key]

identity-matches(?identity: ProcessIdentity, ?pid: F64, ?expected: Sequence<Text>): Bool
  ?identity.pid = ?pid and ?identity.argv = ?expected

export supersede-plan(?desired-key: Text, ?current-pid: F64, ?executable: Text, ?repository: Text, ?owner: LeaseOwner, ?worker: ProcessIdentity, ?child: ProcessIdentity): Deduplicated | Contended | Supersede
  if(?owner.worker-pid != ?current-pid and
     identity-matches(?worker, ?owner.worker-pid, worker-argv(?executable, ?repository, ?owner.key)) and
     identity-matches(?child, ?owner.child-pid, nix-build-argv(?owner.key)),
    if(?desired-key = ?owner.key, {deduplicated: ?desired-key},
      {child-pid: ?owner.child-pid, worker-pid: ?owner.worker-pid}),
    {contended: ?owner.key})

Line:
  kept: Text
  ending: Text

trimmed-line(?text: Text): Line
  fold(characters(?text), {kept: "", ending: ""}, ?line, ?character,
    if(?character = "\r" or ?character = "\n",
      {kept: ?line.kept, ending: ?line.ending ++ ?character},
      {kept: ?line.kept ++ ?line.ending ++ ?character, ending: ""}))

export stamp-current(?stamp: Text, ?key: Text): Bool
  trimmed-line(?stamp).kept = ?key

export stamp-plan(?key: Text, ?exit-status: F64, ?cancelled: Bool, ?output-size: F64, ?output-limit: F64): StampWrite | StampUnchanged
  if(?exit-status = 0 and ?cancelled = false and ?output-size <= ?output-limit,
    {text: "{?key}\n"}, {status: ?exit-status})

RefUpdate:
  old: Text
  new: Text
  ref: Text

InvalidUpdate:
  line: Text

update-fields(?fields: Sequence<Text>, ?line: Text): RefUpdate | InvalidUpdate
  if(count(?fields) = 3,
    {old: first(?fields), new: first(drop(?fields, 1)), ref: last(?fields)}, {line: ?line})

parse-ref-update(?line: Text): RefUpdate | InvalidUpdate
  update-fields(split-delimited(?line, " "), ?line)

all-zero(?text: Text): Bool
  ?text != "" and fold(characters(?text), true, ?zero, ?character, ?zero and ?character = "0")

main-ref-update(?update: RefUpdate): Bool
  ?update.ref = "refs/heads/main" and ?update.old != ?update.new and all-zero(?update.new) = false

line-fires(?line: Text): Bool
  match(parse-ref-update(?line),
    ?update: RefUpdate => main-ref-update(?update),
    ?invalid: InvalidUpdate => false)

export hook-plan(?state: Text, ?lines: Sequence<Text>, ?executable: Text, ?repository: Text, ?key: Text): HookLaunch | HookIgnored
  if(?state = "committed" and fold(?lines, false, ?fires, ?line, ?fires or line-fires(?line)),
    {argv: detached-worker-argv(?executable, ?repository, ?key)}, {state: ?state})

ends-with(?text: Text, ?suffix: Text): Bool
  count(split-text(?text, ?suffix)) > 1 and last(split-text(?text, ?suffix)) = ""

executable-leaf(?value: Text, ?leaf: Text): Bool
  ?value = ?leaf or ends-with(?value, "/{?leaf}")

RebuildScan:
  remaining: Sequence<Text>
  found: Bool

firn-rebuild-at(?argv: Sequence<Text>): Bool
  count(?argv) > 0 and executable-leaf(first(?argv), "firn") and
    (first(drop(?argv, 1)) = "rebuild" or
     (first(drop(?argv, 1)) = "host" and first(drop(?argv, 2)) = "rebuild"))

rebuild-scan(?argv: Sequence<Text>): RebuildScan
  fold(?argv, {remaining: ?argv, found: false}, ?scan, ?value,
    {remaining: drop(?scan.remaining, 1), found: ?scan.found or firn-rebuild-at(?scan.remaining)})

export rebuild-argv(?argv: Sequence<Text>): Bool
  rebuild-scan(?argv).found
