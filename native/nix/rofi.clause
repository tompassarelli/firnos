import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign shell-script(?name: Text, ?text: Text): Package
  construction: "nix"
  call: "writeShellScriptBin"
  from: "pkgs"
  failure: throw

export rofi-module()
  configuration-module(path(myConfig.modules.rofi.enable), "Rofi application launcher",
    {environment: {systemPackages: [package(path(rofi)), shell-script("rofi-rename-workspace", "name=$(echo \"\" | rofi -dmenu -p \"Rename Workspace\")\n[ -n \"$name\" ] && niri msg action set-workspace-name \"$name\"\n\n"), shell-script("rofi-workspace-switcher", "# Parse niri workspaces: \"   1 \"name\"\" or \" * 2 \"name\"\" format\nselected=$(niri msg workspaces | grep -E '^\\s*\\*?\\s*[0-9]+' | \\\n  sed 's/^\\s*\\*\\?\\s*\\([0-9]\\+\\)\\s*\\(\"\\?\\)\\([^\"]*\\)\\(\"\\?\\)/\\1: \\3/' | \\\n  sed 's/: $/: (unnamed)/' | \\\n  rofi -dmenu -p \"Workspace\" -i)\n\n[ -n \"$selected\" ] && \u{7b}\n  id=$(echo \"$selected\" | cut -d: -f1)\n  niri msg action focus-workspace \"$id\"\n}\n\n")]},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeModuleArguments>) =>
         {xdg: {configFile: {"rofi/config.rasi": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/rofi/config.rasi")}}}})}})
