import "nixpkgs.clause"

foreign boolean-type(): OptionType
  construction: "nix"
  get: "types.bool"
  from: "lib"
  failure: throw

export chrome-module()
  {options: {myConfig: {modules: {chrome: {
    enable: enable-option("Enable Google Chrome browser"),
    default: option({type: boolean-type(), default: false, description: "Set Chrome as the default browser via MIME types"})}}}},
   config: when-enabled(configured(path(myConfig.modules.chrome.enable)),
    {environment: {systemPackages: [package(path(google-chrome))]},
     xdg: {mime: {defaultApplications: when-enabled(configured(path(myConfig.modules.chrome.default)),
       {"text/html": "google-chrome.desktop", "x-scheme-handler/http": "google-chrome.desktop", "x-scheme-handler/https": "google-chrome.desktop", "x-scheme-handler/about": "google-chrome.desktop", "x-scheme-handler/unknown": "google-chrome.desktop"})}}})}
