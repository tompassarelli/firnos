import "nixpkgs.clause"

foreign boolean-type(): OptionType
  construction: "nix"
  get: "types.bool"
  from: "lib"
  failure: throw

export librewolf-module()
  {options: {myConfig: {modules: {librewolf: {
    enable: enable-option("Enable LibreWolf browser"),
    default: option({type: boolean-type(), default: false, description: "Set LibreWolf as the default browser via MIME types"})}}}},
   config: when-enabled(configured(path(myConfig.modules.librewolf.enable)),
    {environment: {systemPackages: [package(path(unstable.librewolf))]},
     xdg: {mime: {defaultApplications: when-enabled(configured(path(myConfig.modules.librewolf.default)),
       {"text/html": "librewolf.desktop", "x-scheme-handler/http": "librewolf.desktop", "x-scheme-handler/https": "librewolf.desktop", "x-scheme-handler/about": "librewolf.desktop", "x-scheme-handler/unknown": "librewolf.desktop"})}}})}
