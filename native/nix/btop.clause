import "nixpkgs.clause"

foreign btop(): Package
  construction: "nix"
  get: "btop"
  from: "pkgs"
  failure: throw

foreign enabled(): Bool
  construction: "nix"
  get: "myConfig.modules.btop.enable"
  from: "config"
  failure: throw

export btop-module()
  module({myConfig: {modules: {btop: {enable: enable-option("Enable btop system monitor")}}}}, enabled(), btop())
