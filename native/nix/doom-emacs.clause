import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

DagEntry:
  foreign: "home-manager"
  type: "DagEntry"
Dag:
  entryAfter: Function<Sequence<Text>, Function<Text, DagEntry>>
Colors:
  base00: Text
  base01: Text
  base02: Text
  base03: Text
  base04: Text
  base05: Text
  base06: Text
  base07: Text
  base08: Text
  base09: Text
  base0A: Text
  base0B: Text
  base0C: Text
  base0D: Text
  base0E: Text
  base0F: Text
ColorLibrary:
  colors: Colors
HomeLibrary:
  file: HomeFiles
  dag: Dag
  stylix: ColorLibrary

Font:
  name: Text
Fonts:
  monospace: Font
  sansSerif: Font
  serif: Font
Stylix:
  fonts: Fonts
HomeConfiguration:
  stylix: Stylix
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

export doom-emacs-module()
  configuration-module(path(myConfig.modules.doom-emacs.enable), "Doom Emacs configuration (dotfiles, daemon, secrets)",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {home: {sessionVariables: {DOOMDIR: "{?home.config.home.homeDirectory}/.config/doom", NIXOS_MONO_FONT: ?home.config.stylix.fonts.monospace.name, NIXOS_SANS_FONT: ?home.config.stylix.fonts.sansSerif.name, NIXOS_SERIF_FONT: ?home.config.stylix.fonts.serif.name}, sessionPath: ["{?home.config.home.homeDirectory}/.config/emacs/bin"], activation: {cloneDoomEmacs: ?home.config.lib.dag.entryAfter(["writeBoundary"])("DOOM_DIR=\"{?home.config.home.homeDirectory}/.config/emacs\"\n\n# A symlink is externally managed, even when its target is absent.\nif [ -L \"$DOOM_DIR\" ]; then\n  if [ ! -d \"$DOOM_DIR\" ]; then\n    echo \"warning: $DOOM_DIR is a broken or non-directory symlink; leaving it untouched\" >&2\n  fi\nelif [ ! -e \"$DOOM_DIR\" ]; then\n  $DRY_RUN_CMD {package-text(package(path(git)))}/bin/git clone --depth 1 https://github.com/doomemacs/doomemacs \"$DOOM_DIR\"\n  echo \"Doom Emacs cloned to ~/.config/emacs\"\n  echo \"Run: ~/.config/emacs/bin/doom install\"\nelif [ ! -d \"$DOOM_DIR\" ]; then\n  echo \"error: $DOOM_DIR exists but is not a directory\" >&2\n  exit 1\nfi\n\n")}, file: {".config/doom": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/doom")}}}, services: {emacs: {enable: true, package: package(path(emacs-pgtk)), startWithUserSession: "graphical"}}, xdg: {configFile: {"doom-stylix/stylix-theme-theme.el": {text: ";;; stylix-theme-theme.el --- Generated by NixOS stylix -*- lexical-binding: t; no-byte-compile: t; -*-\n(require 'base16-theme)\n(defvar base16-stylix-theme-colors\n  '(:base00 \"#{?home.config.lib.stylix.colors.base00}\"\n    :base01 \"#{?home.config.lib.stylix.colors.base01}\"\n    :base02 \"#{?home.config.lib.stylix.colors.base02}\"\n    :base03 \"#{?home.config.lib.stylix.colors.base03}\"\n    :base04 \"#{?home.config.lib.stylix.colors.base04}\"\n    :base05 \"#{?home.config.lib.stylix.colors.base05}\"\n    :base06 \"#{?home.config.lib.stylix.colors.base06}\"\n    :base07 \"#{?home.config.lib.stylix.colors.base07}\"\n    :base08 \"#{?home.config.lib.stylix.colors.base08}\"\n    :base09 \"#{?home.config.lib.stylix.colors.base09}\"\n    :base0A \"#{?home.config.lib.stylix.colors.base0A}\"\n    :base0B \"#{?home.config.lib.stylix.colors.base0B}\"\n    :base0C \"#{?home.config.lib.stylix.colors.base0C}\"\n    :base0D \"#{?home.config.lib.stylix.colors.base0D}\"\n    :base0E \"#{?home.config.lib.stylix.colors.base0E}\"\n    :base0F \"#{?home.config.lib.stylix.colors.base0F}\"))\n(deftheme stylix-theme)\n(base16-theme-define 'stylix-theme base16-stylix-theme-colors)\n(provide-theme 'stylix-theme)\n\n"}}}})}})
