import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

export activity-module()
  configuration-module(path(myConfig.modules.activity.enable), "activity — activities own workspaces: two-level layer over niri (daemon + CLI)",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {
        systemd: {user: {services: {activity-daemon: {
          Unit: {Description: "activity daemon (niri activity layer)", PartOf: ["graphical-session.target"], After: ["graphical-session.target"], Requisite: ["graphical-session.target"]},
          Service: {ExecStart: "{configured-text(path(myConfig.modules.users.homeDir))}/.local/bin/activity daemon", Restart: "on-failure", RestartSec: 2},
          Install: {WantedBy: ["niri.service"]}}}}},
        xdg: {configFile: {"activity/activities.json": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/activity/activities.json")}}}})}})
