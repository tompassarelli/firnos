import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

Colors:
  base00: Text
  base01: Text
  base02: Text
  base03: Text
  base04: Text
  base05: Text
  base06: Text
  base07: Text
  base08: Text
  base09: Text
  base0A: Text
  base0B: Text
  base0C: Text
  base0D: Text
  base0E: Text
  base0F: Text
ColorLibrary:
  colors: Colors
HomeLibrary:
  file: HomeFiles
  stylix: ColorLibrary

Font:
  name: Text
Sizes:
  desktop: F64
Fonts:
  monospace: Font
  sizes: Sizes
Opacity:
  desktop: F64
Stylix:
  fonts: Fonts
  opacity: Opacity
HomeConfiguration:
  stylix: Stylix
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign number-text(?value: Delayed<nix,F64>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

export neovim-module()
  configuration-module(path(myConfig.modules.neovim.enable), "Neovim text editor",
    {programs: {neovim: {enable: true, defaultEditor: true}}, home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {xdg: {configFile: {"nvim/init.lua": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/neovim/init.lua")},
          "nvim/lua/stylix-colors.lua": {text: "local M = \u{7b}}\n\n-- Base16 color palette\nM.palette = \u{7b}\n  base00 = \"#{?home.config.lib.stylix.colors.base00}\",\n  base01 = \"#{?home.config.lib.stylix.colors.base01}\",\n  base02 = \"#{?home.config.lib.stylix.colors.base02}\",\n  base03 = \"#{?home.config.lib.stylix.colors.base03}\",\n  base04 = \"#{?home.config.lib.stylix.colors.base04}\",\n  base05 = \"#{?home.config.lib.stylix.colors.base05}\",\n  base06 = \"#{?home.config.lib.stylix.colors.base06}\",\n  base07 = \"#{?home.config.lib.stylix.colors.base07}\",\n  base08 = \"#{?home.config.lib.stylix.colors.base08}\",\n  base09 = \"#{?home.config.lib.stylix.colors.base09}\",\n  base0A = \"#{?home.config.lib.stylix.colors.base0A}\",\n  base0B = \"#{?home.config.lib.stylix.colors.base0B}\",\n  base0C = \"#{?home.config.lib.stylix.colors.base0C}\",\n  base0D = \"#{?home.config.lib.stylix.colors.base0D}\",\n  base0E = \"#{?home.config.lib.stylix.colors.base0E}\",\n  base0F = \"#{?home.config.lib.stylix.colors.base0F}\"\n}\n\n-- Stylix colorscheme setup function (adapted from stylix neovim.nix)\nM.setup = function()\n  -- Try to use mini.base16 if available, fallback to manual highlights\n  local ok, mini_base16 = pcall(require, 'mini.base16')\n  if ok then\n    mini_base16.setup(\u{7b} palette = M.palette })\n  else\n    -- Manual highlight setup as fallback\n    vim.cmd.highlight(\u{7b} \"Normal\", \"guifg=\" .. M.palette.base05, \"guibg=\" .. M.palette.base00 })\n    vim.cmd.highlight(\u{7b} \"Comment\", \"guifg=\" .. M.palette.base03 })\n    vim.cmd.highlight(\u{7b} \"String\", \"guifg=\" .. M.palette.base0B })\n    vim.cmd.highlight(\u{7b} \"Keyword\", \"guifg=\" .. M.palette.base0E })\n    vim.cmd.highlight(\u{7b} \"Function\", \"guifg=\" .. M.palette.base0D })\n    vim.cmd.highlight(\u{7b} \"Type\", \"guifg=\" .. M.palette.base0A })\n    vim.cmd.highlight(\u{7b} \"Constant\", \"guifg=\" .. M.palette.base09 })\n    vim.cmd.highlight(\u{7b} \"Error\", \"guifg=\" .. M.palette.base08 })\n    -- Add transparency if desired\n    -- vim.cmd.highlight(\u{7b} \"Normal\", \"guibg=NONE\", \"ctermbg=NONE\" })\n  end\nend\n\nreturn M\n\n"}}}})}})
