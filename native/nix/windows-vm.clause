import "nixpkgs.clause"

windows-configuration(?username: Delayed<nix,Text>)
  configuration-module(path(myConfig.modules.windows-vm.enable), "Windows VM via QEMU/KVM with virt-manager",
    {virtualisation: {libvirtd: {enable: true, qemu: {package: package(path(qemu_kvm)), swtpm: {enable: true}}}},
     boot: {kernel: {sysctl: {"net.ipv4.ip_forward": 1}}}, programs: {virt-manager: {enable: true}},
     users: {users: dictionary(?username, {extraGroups: ["libvirtd"]})},
     environment: {systemPackages: [package(path(spice-gtk)), package(path(virtio-win))]},
     services: {samba: {enable: true, settings: {
       global: {workgroup: "WORKGROUP", "server string": "NixOS", security: "user", "hosts allow": "192.168.122. 127.0.0.1 localhost", "hosts deny": "0.0.0.0/0"},
       shared: {path: "/home/{?username}/shared", browseable: "yes", "read only": "no", "valid users": ?username, "create mask": "0644", "directory mask": "0755"}}}},
     networking: {firewall: {interfaces: {virbr0: {allowedTCPPorts: [445, 139], allowedUDPPorts: [137, 138]}}}}})

export windows-vm-module()
  windows-configuration(configured-text(path(myConfig.modules.users.username)))
