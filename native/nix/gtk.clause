import "nixpkgs.clause"

Font:
  name: Text
  size: F64
Theme:
  name: Text
Gtk:
  font: Font
  theme: Theme
HomeConfiguration:
  gtk: Gtk
HomeArguments:
  config: HomeConfiguration

foreign force-text(?text: Delayed<nix,Text>): Definition
  construction: "nix"
  call: "mkForce"
  from: "lib"
  failure: throw

foreign number-text(?number: Delayed<nix,F64>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

settings(?dark: Delayed<nix,Bool>, ?home: Delayed<nix,HomeArguments>)
  force-text("[Settings]\ngtk-application-prefer-dark-theme={if(?dark, "1", "0")}\ngtk-font-name={?home.config.gtk.font.name} {number-text(?home.config.gtk.font.size)}\ngtk-theme-name={?home.config.gtk.theme.name}\n\n")

export gtk-module()
  configuration-module(path(myConfig.modules.gtk.enable), "GTK theming configuration",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeArguments>) =>
        {gtk: {enable: true}, home: {packages: [package(path(gsettings-desktop-schemas)), package(path(gtk3))]},
         xdg: {configFile: {
           "gtk-3.0/settings.ini": {text: settings(configured-text(path(stylix.polarity)) = "dark", ?home)},
           "gtk-4.0/settings.ini": {text: settings(configured-text(path(stylix.polarity)) = "dark", ?home)}}},
         dconf: {settings: {"org/gnome/desktop/interface": {color-scheme: force-text(if(configured-text(path(stylix.polarity)) = "dark", "prefer-dark", "prefer-light"))}}}})}})
