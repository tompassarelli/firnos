import "nixpkgs.clause"

foreign boolean-type(): OptionType
  construction: "nix"
  get: "types.bool"
  from: "lib"
  failure: throw

foreign default-boolean(?value: Bool): Definition
  construction: "nix"
  call: "mkDefault"
  from: "lib"
  failure: throw

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

export nyxt-module()
  {options: {myConfig: {modules: {nyxt: {
    enable: enable-option("Enable Nyxt browser"),
    default: option({type: boolean-type(), default: false, description: "Set Nyxt as the default browser via MIME types"})}}}},
   config: when-enabled(configured(path(myConfig.modules.nyxt.enable)),
    {environment: {systemPackages: [package(path(nyxt4))]},
     myConfig: {modules: {fuse: {enable: default-boolean(true)}}},
     programs: {appimage: {enable: true}},
     xdg: {mime: {defaultApplications: when-enabled(configured(path(myConfig.modules.nyxt.default)),
       {"text/html": "nyxt.desktop", "x-scheme-handler/http": "nyxt.desktop", "x-scheme-handler/https": "nyxt.desktop", "x-scheme-handler/about": "nyxt.desktop", "x-scheme-handler/unknown": "nyxt.desktop"})}},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       (?home: Delayed<nix,HomeModuleArguments>) =>
         {xdg: {configFile: dictionary("nyxt/config.lisp",
           {source: ?home.config.lib.file.mkOutOfStoreSymlink(
             "{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/nyxt/config.lisp")})}})}})}
