import "nixpkgs.clause"

PythonPackages:
  boto3: Package

foreign python-with-packages(?select: Delayed<nix,Function<PythonPackages, Sequence<Package>>>): Package
  construction: "nix"
  call: "python3.withPackages"
  from: "pkgs"
  failure: throw

# Keep one Python runtime so a bare interpreter cannot shadow its boto3 environment.
export python-module()
  module(path(myConfig.modules.python.enable), "Python runtime with uv",
    python-with-packages((?ps: Delayed<nix,PythonPackages>) => [?ps.boto3]))
