import "nixpkgs.clause"

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

g203-configuration(?led: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.g203-led.enable), "Logitech G102/G203 LED control",
    {environment: {systemPackages: [?led]},
     services: {udev: {extraRules: "ACTION==\"add\", SUBSYSTEM==\"usb\", ATTR\u{7b}idVendor}==\"046d\", ATTR\u{7b}idProduct}==\"c092\", RUN+=\"{package-text(?led)}/bin/g203-led lightsync solid 000000\"\n\n"}}})

export g203-led-module()
  g203-configuration(package(path(g203-led)))
