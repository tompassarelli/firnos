import "nixpkgs.clause"

export thermal-management-module()
  configuration-module(path(myConfig.modules.thermal-management.enable),
    "CPU thermal management for sustained builds",
    {boot: {kernelParams: ["amd_pstate=active"]},
     services: {auto-cpufreq: {
       enable: true,
       settings: {
         charger: {governor: "performance", turbo: "never",
           energy_performance_preference: "balance_performance"},
         battery: {governor: "powersave", turbo: "never",
           energy_performance_preference: "power"}}}}})
