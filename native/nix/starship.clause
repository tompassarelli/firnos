import "nixpkgs.clause"

foreign concat-strings(?fragments: Sequence<Text>): Text
  construction: "nix"
  call: "concatStrings"
  from: "lib"
  failure: throw

export starship-module()
  configuration-module(path(myConfig.modules.starship.enable), "starship prompt",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      {programs: {starship: {
        enable: true,
        enableFishIntegration: true,
        settings: {
          add_newline: false,
          format: concat-strings(["$directory", "$character"]),
          directory: {truncation_length: 0, truncate_to_repo: false},
          character: {success_symbol: "[λ](bold green)", error_symbol: "[λ](bold red)", vimcmd_symbol: "[λ](bold green)"},
          username: {disabled: true},
          hostname: {disabled: true}}}}})}})
