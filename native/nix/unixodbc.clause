import "nixpkgs.clause"

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

unixodbc-configuration(?driver: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.unixodbc.enable), "unixODBC with MSSQL driver",
    {environment: {
      systemPackages: [package(path(unixodbc)), ?driver],
      variables: {ODBCSYSINI: "/etc", ODBCINI: "/etc/odbc.ini"},
      etc: {
        "odbcinst.ini": {text: "[ODBC Driver 18 for SQL Server]\nDescription = Microsoft ODBC Driver 18 for SQL Server\nDriver = {package-text(?driver)}/lib/libmsodbcsql-18.1.so.1.1\n\n"},
        "odbc.ini": {text: "[msa_data]\nDriver = ODBC Driver 18 for SQL Server\nServer = localhost\nDatabase = msa_data\nTrustServerCertificate = Yes\n\n"}}}})

export unixodbc-module()
  unixodbc-configuration(package(path(unstable.unixodbcDrivers.msodbcsql18)))
