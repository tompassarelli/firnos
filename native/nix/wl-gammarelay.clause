import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

HomeLibrary:
  file: HomeFiles

HomeConfiguration:
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

gamma-configuration(?gamma: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.wl-gammarelay.enable), "Wayland gamma/temperature control",
    {environment: {systemPackages: [?gamma]}, home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {xdg: {configFile: {"wl-gammarelay/temperature-control": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/wl-gammarelay/temperature-control")}}},
         systemd: {user: {services: {wl-gammarelay: {
           Unit: {Description: "Gamma control for Wayland", PartOf: ["graphical-session.target"], After: ["graphical-session.target"], Requisite: ["graphical-session.target"]},
           Service: {ExecStart: "{package-text(?gamma)}/bin/wl-gammarelay-rs", Restart: "on-failure", Type: "dbus", BusName: "rs.wl-gammarelay"}, Install: {WantedBy: ["niri.service"]}}}}}})}})

export wl-gammarelay-module()
  gamma-configuration(package(path(wl-gammarelay-rs)))
