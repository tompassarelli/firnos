import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

Colors:
  base00: Text
  base01: Text
  base02: Text
  base03: Text
  base04: Text
  base05: Text
  base06: Text
  base07: Text
  base08: Text
  base09: Text
  base0A: Text
  base0B: Text
  base0C: Text
  base0D: Text
  base0E: Text
  base0F: Text
ColorLibrary:
  colors: Colors
HomeLibrary:
  file: HomeFiles
  stylix: ColorLibrary

Font:
  name: Text
Sizes:
  desktop: F64
Fonts:
  monospace: Font
  sizes: Sizes
Opacity:
  desktop: F64
Stylix:
  fonts: Fonts
  opacity: Opacity
HomeConfiguration:
  stylix: Stylix
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign number-text(?value: Delayed<nix,F64>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

export waybar-module()
  configuration-module(path(myConfig.modules.waybar.enable), "Waybar status bar for Wayland",
    {environment: {systemPackages: [package(path(waybar))]}, home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {xdg: {configFile: {"waybar/config": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/waybar/config")}, "waybar/style.css": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/waybar/style.css")},
          "waybar/overview-waybar.py": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/waybar/overview-waybar.py")},
          "waybar/stylix.css": {text: "@define-color base00 #{?home.config.lib.stylix.colors.base00};\n@define-color base01 #{?home.config.lib.stylix.colors.base01};\n@define-color base02 #{?home.config.lib.stylix.colors.base02};\n@define-color base03 #{?home.config.lib.stylix.colors.base03};\n@define-color base04 #{?home.config.lib.stylix.colors.base04};\n@define-color base05 #{?home.config.lib.stylix.colors.base05};\n@define-color base06 #{?home.config.lib.stylix.colors.base06};\n@define-color base07 #{?home.config.lib.stylix.colors.base07};\n@define-color base08 #{?home.config.lib.stylix.colors.base08};\n@define-color base09 #{?home.config.lib.stylix.colors.base09};\n@define-color base0A #{?home.config.lib.stylix.colors.base0A};\n@define-color base0B #{?home.config.lib.stylix.colors.base0B};\n@define-color base0C #{?home.config.lib.stylix.colors.base0C};\n@define-color base0D #{?home.config.lib.stylix.colors.base0D};\n@define-color base0E #{?home.config.lib.stylix.colors.base0E};\n@define-color base0F #{?home.config.lib.stylix.colors.base0F};\n\n* \u{7b}\n  font-family: \"{?home.config.stylix.fonts.monospace.name}\";\n  font-size: {number-text(?home.config.stylix.fonts.sizes.desktop)}pt;\n}\n\nwindow#waybar, tooltip \u{7b}\n  background: alpha(@base00, {number-text(?home.config.stylix.opacity.desktop)});\n  color: @base05;\n}\n\ntooltip \u{7b}\n  border-color: @base0D;\n}\n\n.modules-left #workspaces button \u{7b}\n  border-bottom: 3px solid transparent;\n}\n.modules-left #workspaces button.focused,\n.modules-left #workspaces button.active \u{7b}\n  border-bottom: 3px solid @base05;\n}\n\n.modules-center #workspaces button \u{7b}\n  border-bottom: 3px solid transparent;\n}\n.modules-center #workspaces button.focused,\n.modules-center #workspaces button.active \u{7b}\n  border-bottom: 3px solid @base05;\n}\n\n.modules-right #workspaces button \u{7b}\n  border-bottom: 3px solid transparent;\n}\n.modules-right #workspaces button.focused,\n.modules-right #workspaces button.active \u{7b}\n  border-bottom: 3px solid @base05;\n}\n\n"}}},
         systemd: {user: {services: {waybar: {Unit: {Description: "Highly customizable Wayland bar", PartOf: ["graphical-session.target"], After: ["graphical-session.target", "xdg-desktop-portal.service"], Requisite: ["graphical-session.target"]}, Service: {ExecStart: "{package-text(package(path(waybar)))}/bin/waybar", Restart: "on-failure"}, Install: {WantedBy: ["niri.service"]}}, waybar-overview: {Unit: {Description: "Waybar visibility controller (overview + workspace switch)", PartOf: ["graphical-session.target"], After: ["waybar.service"], Requires: ["waybar.service"]}, Service: {ExecStart: "%h/.config/waybar/overview-waybar.py", Restart: "on-failure"}, Install: {WantedBy: ["niri.service"]}}}}}})}})
