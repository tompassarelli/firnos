import "nixpkgs.clause"

Symlink:
  foreign: "home-manager"
  type: "Path"

HomeDirectory:
  homeDirectory: Text

HomeFiles:
  mkOutOfStoreSymlink: Function<Text, Symlink>

Colors:
  base00: Text
  base01: Text
  base02: Text
  base03: Text
  base04: Text
  base05: Text
  base06: Text
  base07: Text
  base08: Text
  base09: Text
  base0A: Text
  base0B: Text
  base0C: Text
  base0D: Text
  base0E: Text
  base0F: Text
ColorLibrary:
  colors: Colors
HomeLibrary:
  file: HomeFiles
  stylix: ColorLibrary

Font:
  name: Text
Sizes:
  desktop: F64
Fonts:
  monospace: Font
  sizes: Sizes
Opacity:
  desktop: F64
Stylix:
  fonts: Fonts
  opacity: Opacity
HomeConfiguration:
  stylix: Stylix
  home: HomeDirectory
  lib: HomeLibrary

HomeModuleArguments:
  config: HomeConfiguration

foreign number-text(?value: Delayed<nix,F64>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

export ironbar-module()
  configuration-module(path(myConfig.modules.ironbar.enable), "Ironbar status bar for Wayland",
    {environment: {systemPackages: [package(path(unstable.ironbar))]}, home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      (?home: Delayed<nix,HomeModuleArguments>) =>
        {xdg: {configFile: {"ironbar/config.toml": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/ironbar/config.toml")},
          "ironbar/style.css": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/ironbar/style.css")},
          "ironbar/overview-ironbar.py": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/ironbar/overview-ironbar.py")},
          "ironbar/battery.sh": {source: ?home.config.lib.file.mkOutOfStoreSymlink("{?home.config.home.homeDirectory}/code/nixos-config/dotfiles/ironbar/battery.sh")},
          "ironbar/stylix.css": {text: "@define-color base00 #{?home.config.lib.stylix.colors.base00};\n@define-color base01 #{?home.config.lib.stylix.colors.base01};\n@define-color base02 #{?home.config.lib.stylix.colors.base02};\n@define-color base03 #{?home.config.lib.stylix.colors.base03};\n@define-color base04 #{?home.config.lib.stylix.colors.base04};\n@define-color base05 #{?home.config.lib.stylix.colors.base05};\n@define-color base06 #{?home.config.lib.stylix.colors.base06};\n@define-color base07 #{?home.config.lib.stylix.colors.base07};\n@define-color base08 #{?home.config.lib.stylix.colors.base08};\n@define-color base09 #{?home.config.lib.stylix.colors.base09};\n@define-color base0A #{?home.config.lib.stylix.colors.base0A};\n@define-color base0B #{?home.config.lib.stylix.colors.base0B};\n@define-color base0C #{?home.config.lib.stylix.colors.base0C};\n@define-color base0D #{?home.config.lib.stylix.colors.base0D};\n@define-color base0E #{?home.config.lib.stylix.colors.base0E};\n@define-color base0F #{?home.config.lib.stylix.colors.base0F};\n\n* \u{7b}\n  font-family: \"{?home.config.stylix.fonts.monospace.name}\";\n  font-size: {number-text(?home.config.stylix.fonts.sizes.desktop)}pt;\n}\n\n.background \u{7b}\n  background: alpha(@base00, {number-text(?home.config.stylix.opacity.desktop)});\n  color: @base05;\n}\n\ntooltip \u{7b}\n  background: alpha(@base00, {number-text(?home.config.stylix.opacity.desktop)});\n  color: @base05;\n  border-color: @base0D;\n}\n\n"}}},
         systemd: {user: {services: {ironbar: {Unit: {Description: "Customizable GTK4 status bar for Wayland", PartOf: ["graphical-session.target"], After: ["graphical-session.target"], Requisite: ["graphical-session.target"]}, Service: {ExecStart: "{package-text(package(path(unstable.ironbar)))}/bin/ironbar", Restart: "on-failure"}, Install: {WantedBy: ["niri.service"]}}, ironbar-overview: {Unit: {Description: "Ironbar overview listener script", PartOf: ["graphical-session.target"], After: ["ironbar.service"], Requires: ["ironbar.service"]}, Service: {ExecStart: "%h/.config/ironbar/overview-ironbar.py", Restart: "on-failure"}, Install: {WantedBy: ["niri.service"]}}}}}})}})
