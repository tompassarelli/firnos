import "nixpkgs.clause"

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw
foreign shell-script(?name: Text, ?text: Delayed<nix,Text>): Package
  construction: "nix"
  call: "writeShellScript"
  from: "pkgs"
  failure: throw

# Only external packages belong here; built-ins can already exist at installation scope.
raco-script(?racket: Delayed<nix,Package>)
  shell-script("raco-ensure-packages", "for pkg in drracket-vim-tool; do\n  if ! {package-text(?racket)}/bin/raco pkg show \"$pkg\" 2>/dev/null | grep -qE \"^[[:space:]]+$pkg[*[:space:]]\"; then\n    {package-text(?racket)}/bin/raco pkg install --auto --skip-installed \"$pkg\"\n  fi\ndone\n\n")

drracket-configuration(?racket: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.drracket.enable), "DrRacket IDE",
    {environment: {systemPackages: [?racket]}, system: {activationScripts: {racoPackages: {text: "/run/wrappers/bin/sudo -u {configured-text(path(myConfig.modules.users.username))} {package-text(raco-script(?racket))} || true\n\n"}}}})

export drracket-module()
  drracket-configuration(package(path(unstable.racket)))
