import "nixpkgs.clause"

foreign boolean-type(): OptionType
  construction: "nix"
  get: "types.bool"
  from: "lib"
  failure: throw

export qutebrowser-module()
  {options: {myConfig: {modules: {qutebrowser: {
    enable: enable-option("Enable Qutebrowser"),
    default: option({type: boolean-type(), default: false, description: "Set Qutebrowser as the default browser via MIME types"})}}}},
   config: when-enabled(configured(path(myConfig.modules.qutebrowser.enable)),
    {environment: {systemPackages: [package(path(qutebrowser))]},
     xdg: {mime: {defaultApplications: when-enabled(configured(path(myConfig.modules.qutebrowser.default)),
       {"text/html": "org.qutebrowser.qutebrowser.desktop", "x-scheme-handler/http": "org.qutebrowser.qutebrowser.desktop", "x-scheme-handler/https": "org.qutebrowser.qutebrowser.desktop", "x-scheme-handler/about": "org.qutebrowser.qutebrowser.desktop", "x-scheme-handler/unknown": "org.qutebrowser.qutebrowser.desktop"})}}})}
