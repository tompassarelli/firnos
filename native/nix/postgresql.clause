import "nixpkgs.clause"

foreign override-text(?priority: F64, ?text: Text): Definition
  construction: "nix"
  call: "lib.mkOverride"
  from: "pkgs"
  failure: throw

postgresql-configuration(?postgres: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.postgresql.enable), "PostgreSQL database server for local development",
    {services: {postgresql: {
      enable: true, package: ?postgres,
      authentication: override-text(10, "# TYPE  DATABASE        USER            ADDRESS                 METHOD\nlocal   all             all                                     trust\nhost    all             all             127.0.0.1/32            trust\nhost    all             all             ::1/128                 trust\n\n"),
      ensureDatabases: ["postgres"],
      ensureUsers: [{name: "postgres", ensureClauses: {superuser: true}}]}},
     environment: {systemPackages: [?postgres]}})

export postgresql-module()
  postgresql-configuration(package(path(unstable.postgresql_18)))
