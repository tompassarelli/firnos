import "nixpkgs.clause"

export proton-autopurge-module()
  configuration-module(path(myConfig.modules.proton-autopurge.enable), "Daily Proton spam autopurge via ~/proton-triage (rescue correspondents, purge the rest)",
    {home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
      {systemd: {user: {
        services: {proton-spam-autopurge: {
          Unit: {Description: "Proton spam autopurge (rescue -> grace -> purge, ledgered)"},
          Service: {Type: "oneshot", ExecStart: "/home/tom/proton-triage/autopurge-run.sh"}}},
        timers: {proton-spam-autopurge: {
          Unit: {Description: "Daily Proton spam autopurge"},
          Timer: {OnCalendar: "*-*-* 09:30", Persistent: true, RandomizedDelaySec: "10m"},
          Install: {WantedBy: ["timers.target"]}}}}}})}})
