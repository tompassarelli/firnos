import "nixpkgs.clause"
FilePath:
  foreign: "nix"
  type: "Path"
foreign microphone-script(): FilePath
  construction: "nix"
  get: root
  from: "./firn-mic"
  failure: throw
foreign file-text(?file: Delayed<nix,FilePath>): Text
  construction: "nix"
  call: "readFile"
  from: "builtins"
  failure: throw

foreign shell-application<Specification: Record>(?specification: Specification): Package
  construction: "nix"
  call: "writeShellApplication"
  from: "pkgs"
  failure: throw
foreign package-text(?value: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

microphone-configuration(?microphone: Delayed<nix,Package>)
  configuration-module(path(myConfig.modules.framework13-mic.enable), "Framework 13 AMD AI 300 mic fix + firn-mic CLI (forces UCM profile that exposes the actual internal mic; see `firn-mic doctor`)",
    {environment: {systemPackages: [?microphone]},
     services: {pipewire: {wireplumber: {extraConfig: {"51-framework13-mic": {"monitor.alsa.rules": [{matches: [{"device.name": "alsa_card.pci-0000_c1_00.6"}], actions: {update-props: {"device.profile": "HiFi (Mic1, Mic2, Speaker)"}}}]}}}}},
     systemd: {services: {firn-mic-alsa-init: {description: "Disable Internal Mic Boost on Framework 13 ALC285", wantedBy: ["multi-user.target"], after: ["sound.target"], path: [package(path(alsa-utils)), package(path(gnugrep)), package(path(gnused)), package(path(coreutils))], serviceConfig: {Type: "oneshot", RemainAfterExit: true}, script: "set -eu\n# Find the card index of the ALC285 codec (stable across reboots).\ncard=$(grep -l 'Realtek ALC285' /proc/asound/card*/codec* 2>/dev/null \\\n        | sed -nE 's|.*/card([0-9]+)/.*|\\1|p' | head -1)\nif [ -z \"$card\" ]; then\n  echo \"firn-mic-alsa-init: ALC285 codec not found, skipping\" >&2\n  exit 0\nfi\namixer -c \"$card\" set 'Internal Mic Boost' 0 >/dev/null\necho \"firn-mic-alsa-init: card$card 'Internal Mic Boost' = 0 dB\"\n\n"}}},
     home-manager: {users: dictionary(configured-text(path(myConfig.modules.users.username)),
       {systemd: {user: {services: {firn-mic-ensure: {Unit: {Description: "Pin Framework 13 mic profile and default source", After: ["pipewire.service", "wireplumber.service"], PartOf: ["pipewire.service"]}, Service: {Type: "oneshot", ExecStartPre: "{package-text(package(path(coreutils)))}/bin/sleep 2", ExecStart: "{package-text(?microphone)}/bin/firn-mic --quiet", RemainAfterExit: true}, Install: {WantedBy: ["pipewire.service"]}}}}}})}})

export framework13-mic-module()
  microphone-configuration(shell-application({name: "firn-mic", runtimeInputs: [package(path(wireplumber)), package(path(pipewire)), package(path(jq)), package(path(python3)), package(path(coreutils)), package(path(gnugrep)), package(path(gawk)), package(path(gnused))], text: file-text(microphone-script())}))
