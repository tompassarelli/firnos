import "nixpkgs.clause"

foreign package-text(?package: Delayed<nix,Package>): Text
  construction: "nix"
  call: "toString"
  from: "builtins"
  failure: throw

foreign text-directory(?name: Text, ?text: Text): Package
  construction: "nix"
  call: "writeTextDir"
  from: "pkgs"
  failure: throw

export mini-serve-module()
  configuration-module(path(myConfig.modules.mini-serve.enable), "Enable mini-serve localhost background page",
    {systemd: {services: {mini-serve: {
      description: "Minimal localhost web server", wantedBy: ["multi-user.target"], after: ["network.target"],
      serviceConfig: {
        ExecStart: "{package-text(package(path(darkhttpd)))}/bin/darkhttpd {package-text(text-directory("index.html", "<!DOCTYPE html><html><body style=\"background:#2b3339;margin:0\"></body></html>\n\n"))} --port 39847 --addr 127.0.0.1",
        Restart: "always", DynamicUser: true}}}}})
